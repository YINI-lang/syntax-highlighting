#!/usr/bin/env yini
# Optional shebang, must appear on first line

/*
    *** NOTE ***
    Version: 2.0.0

    A comprehensive strict-mode YINI example that exercises as
    many syntax features, section header styles, data
    types, and comment types/styles as possible.
*/

/*
    Example of a strict YINI document - all features showcased.
*/

/*
 * All comment types/styles.
 */
// Block comments as above, and inline double-slash comments.
; Semicolon full-line comment. It must be the first non-whitespace content on the line.
# Hash comment. Since RC6, hash always starts a comment.
#   Hash comment with tabs and spaces after hash.
-- Disabled line, ignored by the parser.
--env = "dev"  // Disabled assignment, ignored by the parser.
// Double-slash comment.

/*
 * All basic types.
 */
^ TopSection                // Strict mode uses one explicit top-level section.

; Strings are raw by default. Strings must be enclosed in quotes.
rawStr = 'Hello world'
string1 = "My Service Name"     // Double-quoted raw string.
string2 = 'My Service Name'     // Single-quoted raw string.
string3 = "C:\Users\Name"       // Backslashes are preserved in raw strings.
string4 = './**'
string5 = "\__/"                # Hash inline comment.
string6 = '**/*.js.map'         # Hash inline comment.

; Integer numbers.
int1 = 42
int2 = -1
int3 = 0
int4 = +7

; Floating point numbers.
float1 = 0.42
float2 = -0.123
float3 = 0.0
float4 = 0.00
float5 = 321.0001
float6 = -99.0099

; Boolean literals are case-insensitive.
bool1 = true
bool2 = false
bool3 = Yes     # Alternative true.
bool4 = NO      # Alternative false.
bool5 = ON      # Alternative true.
bool6 = Off     # Alternative false.

; Null literals are case-insensitive.
null1 = null
null2 = Null
null3 = NULL

/*
 * More advanced number notations.
 */
^^ MoreAdvancedNumbers      // Sub-section of "TopSection".

; Exponential numbers, also known as scientific notation.
exp1 = 0.99e3
exp2 = -0.30e2
exp3 = 1.0e0
exp4 = .5e2
exp5 = 1.23E+4

; Hexadecimal notation.
hex1 = 0xDEADBEEF
hex2a = hex:FFEEAA
hex2b = HEX:ffeeaa
hex3 = 0XF390

; Binary notation.
bin1 = 0b101010
bin2 = %101010
bin3 = 0B110011

; Octal notation.
oct1 = 0o755
oct2 = 0O7477

; Dozenal notation.
doz1 = 0z10
doz2 = 0zx
doz3 = 0ze
doz4 = 0Z2Ex9

; Raw strings can optionally be prefixed with R or r to be explicit.
rawString1 = R'This is a "raw" string. No escapes are interpreted.'
rawString2 = r"This is a\n**raw**\nstring. No escapes are interpreted."

; Classic strings are prefixed with C or c.
; They support and interpret escape sequences such as \n and \t.
classicStr1 = C'Hello,\nWorld!\tWelcome to YINI.'
classicStr2 = c"Hello,\nWorld!\tWelcome to YINI."
classicEscapes = C"Quotes: \"double\", \'single\'; hex \x41; unicode \u0041; octal \o101."

; String concatenation uses + and must remain on one line.
concatStr1 = "Hello" + " " + "World!"
concatStr2 = R"raw-" + C"classic"

; Triple-quoted strings are multi-line strings.
; Triple-quoted strings are raw by default.
tripleQStr = """Raw triple-quoted
string with \n not interpreted
and line breaks kept."""

; R-prefixed triple-quoted strings are explicitly raw.
tripleQRawStr = R"""Explicit raw triple-quoted
string with line breaks kept."""

; C-prefixed triple-quoted strings interpret escape sequences.
tripleQClassicStr = C"""Classic triple-quoted string.
Escapes such as \n and \t are interpreted."""

tripleQClassicStr2 = c"""Lowercase classic triple-quoted string.
Escapes such as \n and \t are interpreted."""

; Section names in headers can be backticked if they include
; spaces or special characters.
^^ `Backticked Section Name`

; Member keys can also be backticked.
`Project Name` = "My Project"
`Created By` = "Jane Developer"
`License Type` = "MIT"
`Is Active` = true
`Amanda's Project` = "Special characters in a key"
`Build-Target` = "release"

    ^^^ Cache            // Nested section. Indentation is for readability only.
    type = "redis"
    TTL = 3600
    enabled = false
    list = [1, 2, 3, "str", true, null]
    list_trailing_comma = ["a", "b"]     // Strict mode disallows a trailing comma.
    implicitNull = null                  // Strict mode uses explicit null.
    nestedList = [
        ["stylesheet", "css/general.css"],
        ["stylesheet", "css/themes.css"]
    ]
    inlineObject = { id: 1, name: "Main", enabled: true, tags: ["a", "b", "c"] }
    nestedInlineObject = { owner: { name: "Jane", active: true }, limits: { ttl: 3600, retries: 3 } }
    inlineObjectList = [
        { role: "admin", value: 1 },
        { role: "user", value: 2 },
        { role: "guest", value: 0 }
    ]
    modeInlineObject = { timeout: 30, retries: 3 }     // Strict mode requires : inside inline objects.

        ^^^^ Options     // Third-level section.
        host = '127.0.0.1'
        port = 6379
        object_id = 1
        object_name = "Main"
        object_tags = ["a", "b", "c"]
        _list = ['style', ['Volvo', 'Doc', 'Cat']]
        _meta1 = ['font', 42, 'UI', [55, 44, 33], "default", 'description of']
        _meta2 = [
            ["admin", 1],
            ["user", 2],
            ["guest", 0]
        ]

^^ Env                    // Sub-section of the strict-mode root.
code = "dev"
mode = on
pi = 3.14159
list_empty = []

; Repeated marker section headers.
^^ Database              # Section header using repeated marker form.
enabled = true
user = "root"
password = 'secret'
roles = ["admin", "user", "guest"]
timeout = null

    ^^^ Cache            # Sub-section using repeated marker form.
    type = "memcached"
    TTL = 1800

        ^^^^ Options     # Third-level sub-section using repeated marker form.
        host = "192.168.1.1"
        port = 11211

<< AlternativeMarkerSection
val = 123

    <<< AltSubSection
    val2 = "abc"

        <<<< AltThirdLevel
        val3 = false

/END // Required in strict mode.

// End of demo.
