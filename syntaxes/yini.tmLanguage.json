{
  "name": "YINI",
  "scopeName": "source.yini",
  "patterns": [
    { "include": "#shebang" },
    { "include": "#disabled-line" },
    { "include": "#comments" },
    { "include": "#yini-marker" },
    { "include": "#document-terminator" },
    { "include": "#sections" },
    { "include": "#keys" },
    { "include": "#string-expression" },
    { "include": "#objects" },
    { "include": "#lists" },
    { "include": "#numbers" },
    {
      "name": "constant.language.boolean.yini",
      "match": "(?i)\\b(true|false|on|off|yes|no)\\b"
    },
    {
      "name": "constant.language.null.yini",
      "match": "(?i)\\bnull\\b"
    },
    {
      "name": "keyword.operator.assignment.yini",
      "match": "="
    },
    {
      "name": "keyword.operator.concatenation.yini",
      "match": "\\+"
    },
    {
      "name": "punctuation.separator.key-value.yini",
      "match": ":"
    },
    {
      "name": "punctuation.separator.sequence.yini",
      "match": ","
    }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.yini",
      "match": "\\A(?:\\uFEFF)?#!.*$"
    },
    "disabled-line": {
      "name": "meta.line.disabled.yini",
      "match": "^[ \\t]*--.*$"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yini",
          "match": "//.*$"
        },
        {
          "name": "comment.line.hash.yini",
          "match": "#.*$"
        },
        {
          "name": "comment.line.semicolon.yini",
          "match": "^[ \\t]*;.*$"
        },
        {
          "name": "comment.block.yini",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "yini-marker": {
      "name": "meta.directive.yini",
      "match": "^([ \\t]*)(@(?i:yini))(?:[ \\t]+((?i:strict|lenient)))?\\b",
      "captures": {
        "2": { "name": "keyword.control.directive.yini" },
        "3": { "name": "storage.modifier.mode.yini" }
      }
    },
    "document-terminator": {
      "name": "keyword.control.terminator.yini",
      "match": "^[ \\t]*(?i:/END)\\b"
    },
    "sections": {
      "patterns": [
        {
          "name": "meta.section.yini",
          "match": "^([ \\t]*)([\\^§<>](?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[1-9]))([ \\t]+(?:/\\*(?:[^*\\r\\n]|\\*(?!/))*\\*/[ \\t]*)*)((?:[A-Za-z_][A-Za-z0-9_]*|`(?:\\\\[`\\\\]|[^`\\\\\\x00-\\x1F\\x7F-\\x9F])*`))(?![A-Za-z0-9_])",
          "captures": {
            "2": { "name": "punctuation.definition.section.yini" },
            "4": { "name": "entity.name.section.yini" },
            "3": {
              "patterns": [
                { "include": "#comments" }
              ]
            }
          }
        },
        {
          "name": "meta.section.yini",
          "match": "^([ \\t]*)((?:\\^(?:_?\\^){0,8}|§(?:_?§){0,8}|>(?:_?>){0,8}|<(?:_?<){0,8}))([ \\t]*(?:/\\*(?:[^*\\r\\n]|\\*(?!/))*\\*/[ \\t]*)*)((?:[A-Za-z_][A-Za-z0-9_]*|`(?:\\\\[`\\\\]|[^`\\\\\\x00-\\x1F\\x7F-\\x9F])*`))(?![A-Za-z0-9_])",
          "captures": {
            "2": { "name": "punctuation.definition.section.yini" },
            "4": { "name": "entity.name.section.yini" },
            "3": {
              "patterns": [
                { "include": "#comments" }
              ]
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.command.yini",
          "begin": "(?<![A-Za-z0-9_])(command)(\"\"\")(?=\\r?$)",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "^ *(\"\"\")(?=\\r?$)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.triple.double.escaped.yini",
          "begin": "(?<![A-Za-z0-9_])([Ee])(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.single.escaped.yini",
          "begin": "(?<![A-Za-z0-9_])([Ee])(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "'|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.double.escaped.yini",
          "begin": "(?<![A-Za-z0-9_])([Ee])(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.triple.double.classic.yini",
          "begin": "(?<![A-Za-z0-9_])([Cc])(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.triple.double.raw.yini",
          "begin": "(?<![A-Za-z0-9_])([Rr])(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.triple.double.raw.yini",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.single.classic.yini",
          "begin": "(?<![A-Za-z0-9_])([Cc])(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "'|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.double.classic.yini",
          "begin": "(?<![A-Za-z0-9_])([Cc])(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          },
          "patterns": [
            { "include": "#escaped-escape" }
          ]
        },
        {
          "name": "string.quoted.single.raw.yini",
          "begin": "(?<![A-Za-z0-9_])([Rr])(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "'|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.double.raw.yini",
          "begin": "(?<![A-Za-z0-9_])([Rr])(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.yini" },
            "2": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.single.raw.yini",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "'|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        },
        {
          "name": "string.quoted.double.raw.yini",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.yini" }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.yini" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.yini",
          "match": "(?<![A-Za-z0-9_])[+-]?(?i:hex:)_?[0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.hex.yini",
          "match": "(?<![A-Za-z0-9_])[+-]?(?i:0x)_?[0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.binary.yini",
          "match": "(?<![A-Za-z0-9_])[+-]?(?:(?i:0b)|%)_?[01](?:_?[01])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.octal.yini",
          "match": "(?<![A-Za-z0-9_])[+-]?(?i:0o)_?[0-7](?:_?[0-7])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.duodecimal.yini",
          "match": "(?<![A-Za-z0-9_])[+-]?(?i:0z)_?[0-9ABEXabex](?:_?[0-9ABEXabex])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.decimal.yini",
          "match": "(?<![A-Za-z0-9_.])[+-]?(?:[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![A-Za-z0-9_.])"
        }
      ]
    },
    "keys": {
      "match": "(?<![A-Za-z0-9_])((?:[A-Za-z_][A-Za-z0-9_]*|`(?:\\\\[`\\\\]|[^`\\\\\\x00-\\x1F\\x7F-\\x9F])*`))(?=[ \\t]*(?:/\\*(?:[^*\\r\\n]|\\*(?!/))*\\*/[ \\t]*)*=)",
      "captures": {
        "1": { "name": "variable.other.key.yini" }
      }
    },
    "escaped-escape": {
      "name": "constant.character.escape.yini",
      "match": "\\\\(?:[\\\\'\"/`0?abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|o[0-7]{1,3})"
    },
    "values": {
      "patterns": [
        { "include": "#disabled-line" },
        { "include": "#comments" },
        { "include": "#string-expression" },
        { "include": "#objects" },
        { "include": "#lists" },
        { "include": "#numbers" },
        {
          "name": "constant.language.boolean.yini",
          "match": "(?i)\\b(true|false|on|off|yes|no)\\b"
        },
        {
          "name": "constant.language.null.yini",
          "match": "(?i)\\bnull\\b"
        }
      ]
    },
    "objects": {
      "name": "meta.object.yini",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.yini" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.yini" }
      },
      "patterns": [
        { "include": "#disabled-line" },
        { "include": "#comments" },
        {
          "name": "meta.object.member.yini",
          "begin": "((?:[A-Za-z_][A-Za-z0-9_]*|`(?:\\\\[`\\\\]|[^`\\\\\\x00-\\x1F\\x7F-\\x9F])*`))([ \\t]*)([:=])",
          "beginCaptures": {
            "1": { "name": "variable.other.key.yini" },
            "3": {
              "patterns": [
                {
                  "name": "punctuation.separator.key-value.yini",
                  "match": ":"
                },
                {
                  "name": "keyword.operator.assignment.yini",
                  "match": "="
                }
              ]
            }
          },
          "end": "(?=[,}])",
          "patterns": [
            { "include": "#values" },
            {
              "name": "keyword.operator.concatenation.yini",
              "match": "\\+"
            }
          ]
        },
        {
          "name": "punctuation.separator.sequence.yini",
          "match": ","
        }
      ]
    },
    "lists": {
      "name": "meta.list.yini",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.yini" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.yini" }
      },
      "patterns": [
        { "include": "#values" },
        {
          "name": "keyword.operator.concatenation.yini",
          "match": "\\+"
        },
        {
          "name": "punctuation.separator.sequence.yini",
          "match": ","
        }
      ]
    },
    "string-expression": {
      "name": "meta.string-expression.yini",
      "begin": "(?=(?<![A-Za-z0-9_])(?:[RrEeCc][\\\"']|command\\\"\\\"\\\"(?=\\r?$))|[\\\"'])",
      "end": "(?=$|[,}\\]])",
      "patterns": [
        { "include": "#strings" },
        { "include": "#comments" },
        {
          "name": "keyword.operator.concatenation.yini",
          "match": "\\+"
        },
        { "include": "#numbers" },
        {
          "name": "constant.language.boolean.yini",
          "match": "(?i)\\b(true|false|on|off|yes|no)\\b"
        },
        {
          "name": "constant.language.null.yini",
          "match": "(?i)\\bnull\\b"
        }
      ]
    }
  },
